# ===== PREDICTION_AI_V7 =====
# v7 adds market consensus features (1X2 / O2.5 / BTTS), odds movement, learned
# stacking (poisson+elo+ml+market) and isotonic calibration on top of the v6
# ensemble. Set SCIENTIFIC_V7_ENABLED=false to fully revert to v6 behavior.
SCIENTIFIC_V7_ENABLED=true
SCIENTIFIC_STACKING_ENABLED=true
SCIENTIFIC_STACK_EPOCHS=300
SCIENTIFIC_STACK_LR=0.05
SCIENTIFIC_STACK_SEED=20260821
SCIENTIFIC_ISOTONIC_BINS=20
SCIENTIFIC_MARKET_MIN_BOOKMAKERS=2
SCIENTIFIC_MARKET_MAX_AGE_HOURS=168

