SCIENTIFIC_TRAINING_RATE=0.035
SCIENTIFIC_TRAINING_L2=0.002
SCIENTIFIC_MODEL_WEIGHT=0.65
SCIENTIFIC_MARKET_WEIGHT=0.35
SCIENTIFIC_MIN_EV=0.035
SCIENTIFIC_MIN_EDGE=0.02
SCIENTIFIC_MIN_CONFIDENCE=0.45
SCIENTIFIC_MIN_DATA_QUALITY=0.40
SCIENTIFIC_MIN_COMPLETE_BOOKMAKERS=3
SCIENTIFIC_MIN_REFERENCE_BOOKMAKERS=2
SCIENTIFIC_MAX_PROBABILITY_STDDEV=0.055
SCIENTIFIC_MAX_PER_FIXTURE=3
SCIENTIFIC_MAX_PER_MARKET=1
