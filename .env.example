# ===== API CALL BUDGET (PREDICTION_AI_V7_QUOTA) =====
# With a Pro plan (7500 req/day) the default cron cadence below uses roughly
# 3-5k requests/day. Tune with the budget knobs:
#   API_QUOTA_MIN_RESERVE   — jobs back off when remaining quota <= this
#   * _MAX_FIXTURES         — cap fixtures touched per run (nearest kickoff first)
# For a Free plan (100 req/day) set WORKER_SCHEDULER_ENABLED=false and sync
# manually once or twice a day; or use the much slower cadences below.
API_QUOTA_MIN_RESERVE=250
ODDS_SYNC_MAX_FIXTURES=40
PREDICTION_SYNC_MAX_FIXTURES=20
LINEUP_SYNC_MAX_FIXTURES=10
ODDS_REPEATED_MAX_FIXTURES_PER_RUN=8
ODDS_SYNC_DAYS_AHEAD=4

# Conservative cadences (safe for Pro 7.5k, ~1.2-1.8k req/day).
# sync-odds now uses BULK-BY-DATE: one call per date covers ALL fixtures.
FIXTURE_SYNC_CRON="0 */6 * * *"
ODDS_REPEATED_ENABLED=false          # bulk sync-odds đã bao phủ movement
ODDS_SYNC_CRON="*/30 * * * *"
PREDICTION_SYNC_CRON="30 4 * * *"    # 1 lần/ngày (external predictions chỉ 8% trọng số)
RECOMMENDATION_CRON="*/15 * * * *"
SETTLEMENT_CRON=3,13,23,33,43,53 * * * *

# Production scientific History pipeline. The refresh discovers current
# fixtures/checkpoints; the live cycle collects due odds before snapshotting.
SCIENTIFIC_CURRENT_REFRESH_ENABLED=true
# PREDICTION_AI_V7_QUOTA: stats/injury/lineup context backfill is heavy —
# weekly instead of every 2 days.
SCIENTIFIC_CURRENT_REFRESH_CRON="30 7 * * 1"
SCIENTIFIC_CURRENT_REFRESH_DAYS=14
SCIENTIFIC_LIVE_CYCLE_CRON="*/5 * * * *"

# ===== DEV AUTOPILOT (chạy song song với worker khi npm run dev) =====
# Đây là nguồn call API lớn nhất khi chạy dev. Default mới đã tiết kiệm.
# Không cần autopilot thì tắt hẳn:
DEV_SCIENTIFIC_AUTOPILOT_ENABLED=true
DEV_SCIENTIFIC_AUTOPILOT_TICK_SECONDS=300
DEV_SCIENTIFIC_AUTOPILOT_REFRESH_MINUTES=720
DEV_SCIENTIFIC_AUTOPILOT_STATISTICS_MINUTES=360
DEV_SCIENTIFIC_AUTOPILOT_INJURY_MINUTES=240
DEV_SCIENTIFIC_AUTOPILOT_PLAN_MINUTES=30
DEV_SCIENTIFIC_AUTOPILOT_DAYS=30

