import { BacktestDashboard } from '../../components/BacktestDashboard';
import { ScientificBacktestPanel } from '../../components/ScientificBacktestPanel';
import { apiFetch } from '../../lib/api';
import type { BacktestDetailDto, BacktestRunDto, LeagueDto } from '../../lib/types';
import type { ScientificDashboardDto } from '../../lib/scientific-types';

export default async function BacktestPage() {
  const [runsResponse, leaguesResponse] = await Promise.all([
    apiFetch<{ data: BacktestRunDto[] }>('/backtests?limit=20'),
    apiFetch<{ data: LeagueDto[] }>('/leagues'),
  ]);

  const latest = runsResponse.data.find((run) => run.status === 'SUCCESS') ?? runsResponse.data[0];
  let detail: BacktestDetailDto | null = null;
  if (latest) {
    try {
      detail = await apiFetch<BacktestDetailDto>(`/backtests/${latest.id}`);
    } catch {
      detail = null;
    }
  }

  let scientific: ScientificDashboardDto | null = null;
  try {
    scientific = await apiFetch<ScientificDashboardDto>('/scientific/dashboard');
  } catch {
    scientific = null;
  }

  return (
    <>
      <ScientificBacktestPanel initialData={scientific} />
      <section className="beta1d-legacy">
        <div className="beta1d-legacy-label">
          <span className="eyebrow">LEGACY / REGRESSION VIEW</span>
          <h2>Backtest engine hiện hữu</h2>
          <p>Được giữ nguyên để so sánh và tránh phá baseline trong beta.1D.</p>
        </div>
        <BacktestDashboard
          initialRuns={runsResponse.data}
          initialDetail={detail}
          leagues={leaguesResponse.data}
        />
      </section>
    </>
  );
}
