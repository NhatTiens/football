generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FixtureStatus {
  UPCOMING
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum RecommendationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SETTLED
}

enum SettlementResult {
  PENDING
  WIN
  LOSS
  PUSH
  VOID
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BacktestStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum AuthRole {
  USER
  ANALYST
  ADMIN
}

enum AuthUserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum AuthPlan {
  FREE
  PRO
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum BillingPlanStatus {
  ACTIVE
  INACTIVE
}

enum BillingDurationUnit {
  DAY
  MONTH
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model AuthUser {
  id                  Int                    @id @default(autoincrement())
  email               String                 @unique
  name                String
  passwordHash        String
  role                AuthRole               @default(USER)
  status              AuthUserStatus         @default(PENDING_VERIFICATION)
  plan                AuthPlan               @default(FREE)
  emailVerifiedAt     DateTime?
  proExpiresAt        DateTime?
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  trialUsed           Boolean                @default(false)
  forcePasswordChange Boolean                @default(false)
  failedLoginCount    Int                    @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?                @db.VarChar(64)
  lastLoginUserAgent  String?                @db.VarChar(255)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  sessions            AuthSession[]
  verificationCodes   AuthVerificationCode[]
  usageEntries        AuthUsageDaily[]
  paymentOrders       PaymentOrder[]
  subscriptions       Subscription[]
  trialClaim          TrialClaim?
  promotionUsages     PromotionUsage[]
  promotionCounters   PromotionUserCounter[]

  @@index([role])
  @@index([status])
  @@index([plan])
  @@index([lockedUntil])
}

model AuthSession {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(255)
  createdAt  DateTime  @default(now())
  user       AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AuthVerificationCode {
  id           Int             @id @default(autoincrement())
  userId       Int
  purpose      AuthCodePurpose
  codeHash     String          @db.VarChar(128)
  expiresAt    DateTime
  usedAt       DateTime?
  supersededAt DateTime?
  createdAt    DateTime        @default(now())
  user         AuthUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([purpose, expiresAt])
}

model AuthUsageDaily {
  id         Int      @id @default(autoincrement())
  userId     Int
  featureKey String   @db.VarChar(64)
  usageDate  DateTime @db.Date
  used       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey, usageDate])
  @@index([featureKey, usageDate])
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int
  action      String   @db.VarChar(64)
  targetType  String   @db.VarChar(64)
  targetId    String?  @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}

model TrialClaim {
  id        Int       @id @default(autoincrement())
  emailHash String    @unique @db.VarChar(64)
  userId    Int?      @unique
  startedAt DateTime
  endsAt    DateTime
  used      Boolean   @default(true)
  createdAt DateTime  @default(now())
  user      AuthUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([endsAt])
}

model BillingPlan {
  id             Int                    @id @default(autoincrement())
  code           String                 @unique @db.VarChar(32)
  name           String                 @db.VarChar(120)
  description    String?                @db.Text
  durationCount  Int
  durationUnit   BillingDurationUnit
  basePriceVnd   Int
  currency       String                 @default("VND") @db.VarChar(8)
  purchasable    Boolean                @default(true)
  status         BillingPlanStatus      @default(ACTIVE)
  sortOrder      Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  promotionLinks BillingPlanPromotion[]
  paymentOrders  PaymentOrder[]
  subscriptions  Subscription[]

  @@index([status, sortOrder])
}

model Promotion {
  id                  Int                    @id @default(autoincrement())
  name                String                 @db.VarChar(160)
  code                String?                @unique @db.VarChar(64)
  description         String?                @db.Text
  type                PromotionType
  discountValue       Float?
  fixedPriceVnd       Int?
  automatic           Boolean                @default(false)
  startAt             DateTime
  endAt               DateTime?
  maxUses             Int?
  claimedCount        Int                    @default(0)
  usedCount           Int                    @default(0)
  maxUsesPerUser      Int?
  priority            Int                    @default(0)
  status              PromotionStatus        @default(INACTIVE)
  newUsersOnly        Boolean                @default(false)
  firstPurchaseOnly   Boolean                @default(false)
  minimumDurationDays Int?
  deletedAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  planLinks           BillingPlanPromotion[]
  usages              PromotionUsage[]
  userCounters        PromotionUserCounter[]
  paymentOrders       PaymentOrder[]

  @@index([status, startAt, endAt])
  @@index([priority, status])
}

model BillingPlanPromotion {
  billingPlanId Int
  promotionId   Int
  billingPlan   BillingPlan @relation(fields: [billingPlanId], references: [id], onDelete: Cascade)
  promotion     Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([billingPlanId, promotionId])
  @@index([promotionId])
}

model PromotionUsage {
  id          Int          @id @default(autoincrement())
  promotionId Int
  userId      Int
  orderId     Int          @unique
  usedAt      DateTime     @default(now())
  promotion   Promotion    @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user        AuthUser     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([promotionId, userId, orderId])
  @@index([promotionId, usedAt])
  @@index([userId, usedAt])
}

model PromotionUserCounter {
  promotionId  Int
  userId       Int
  claimedCount Int       @default(0)
  usedCount    Int       @default(0)
  updatedAt    DateTime  @updatedAt
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user         AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([promotionId, userId])
  @@index([userId])
}

model PaymentOrder {
  id                    Int                   @id @default(autoincrement())
  userId                Int
  orderCode             String                @unique @db.VarChar(64)
  planCode              String                @db.VarChar(32)
  amountVnd             Int
  billingPlanId         Int?
  originalPriceVnd      Int?
  discountAmountVnd     Int?
  finalPriceVnd         Int?
  currency              String                @default("VND") @db.VarChar(8)
  promotionId           Int?
  promotionCode         String?               @db.VarChar(64)
  promotionClaimed      Boolean               @default(false)
  durationCount         Int?
  durationUnit          BillingDurationUnit?
  pricingSnapshot       Json?
  status                PaymentOrderStatus    @default(PENDING)
  provider              String                @db.VarChar(32)
  activeKey             String?               @unique @db.VarChar(128)
  transferContent       String                @db.VarChar(128)
  qrUrl                 String?               @db.Text
  expiresAt             DateTime
  paidAt                DateTime?
  providerTransactionId String?               @db.VarChar(128)
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  AuthUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingPlan           BillingPlan?          @relation(fields: [billingPlanId], references: [id], onDelete: SetNull)
  promotion             Promotion?            @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionUsage        PromotionUsage?
  subscriptions         Subscription[]
  webhookEvents         PaymentWebhookEvent[]

  @@unique([provider, providerTransactionId])
  @@index([userId, createdAt])
  @@index([billingPlanId, status, createdAt])
  @@index([promotionId, status, createdAt])
  @@index([status, expiresAt])
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  userId               Int
  planCode             String             @db.VarChar(32)
  billingPlanId        Int?
  status               SubscriptionStatus @default(ACTIVE)
  startsAt             DateTime
  expiresAt            DateTime
  sourcePaymentOrderId Int?
  autoRenew            Boolean            @default(false)
  pricePaidVnd         Int?
  currency             String             @default("VND") @db.VarChar(8)
  metadata             Json?
  createdAt            DateTime           @default(now())
  user                 AuthUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingPlan          BillingPlan?       @relation(fields: [billingPlanId], references: [id], onDelete: SetNull)
  sourcePaymentOrder   PaymentOrder?      @relation(fields: [sourcePaymentOrderId], references: [id], onDelete: SetNull)

  @@unique([sourcePaymentOrderId])
  @@index([userId, createdAt])
  @@index([billingPlanId, status, expiresAt])
  @@index([status, expiresAt])
}

model PaymentWebhookEvent {
  id               Int           @id @default(autoincrement())
  provider         String        @db.VarChar(32)
  externalId       String        @db.VarChar(128)
  payloadHash      String        @db.VarChar(64)
  receivedAt       DateTime      @default(now())
  processingStatus String        @db.VarChar(32)
  orderId          Int?
  errorReason      String?       @db.Text
  rawPayload       Json?
  createdAt        DateTime      @default(now())
  order            PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([processingStatus, receivedAt])
  @@index([orderId, receivedAt])
}

model League {
  id           Int           @id @default(autoincrement())
  apiLeagueId  Int
  season       Int
  name         String
  country      String?
  logoUrl      String?       @db.Text
  coverage     Json?
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  fixtures     Fixture[]
  backtestRuns BacktestRun[]

  @@unique([apiLeagueId, season])
  @@index([enabled])
}

model Team {
  id              Int                     @id @default(autoincrement())
  apiTeamId       Int                     @unique
  name            String
  code            String?
  country         String?
  logoUrl         String?                 @db.Text
  venueName       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  homeFixtures    Fixture[]               @relation("HomeTeam")
  awayFixtures    Fixture[]               @relation("AwayTeam")
  lineupSnapshots FixtureLineupSnapshot[]
}

model Fixture {
  id                           Int                                  @id @default(autoincrement())
  apiFixtureId                 Int                                  @unique
  leagueId                     Int
  homeTeamId                   Int
  awayTeamId                   Int
  kickoffAt                    DateTime
  timezone                     String?
  round                        String?
  venueName                    String?
  referee                      String?
  status                       FixtureStatus                        @default(UPCOMING)
  apiStatusShort               String?
  elapsedMinutes               Int?
  homeGoals                    Int?
  awayGoals                    Int?
  halftimeHomeGoals            Int?
  halftimeAwayGoals            Int?
  rawPayload                   Json?
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
  league                       League                               @relation(fields: [leagueId], references: [id])
  homeTeam                     Team                                 @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam                     Team                                 @relation("AwayTeam", fields: [awayTeamId], references: [id])
  oddsSnapshots                OddsSnapshot[]
  oddsCollectionCheckpoints    OddsCollectionCheckpoint[]
  contextCollectionCheckpoints FixtureContextCollectionCheckpoint[]
  externalPrediction           ExternalPrediction?
  recommendations              Recommendation[]
  backtestBets                 BacktestBet[]
  lineupSnapshots              FixtureLineupSnapshot[]

  @@index([kickoffAt])
  @@index([leagueId, status, kickoffAt])
  @@index([homeTeamId, kickoffAt])
  @@index([awayTeamId, kickoffAt])
}

model Player {
  id              Int                   @id @default(autoincrement())
  apiPlayerId     Int                   @unique
  name            String
  photoUrl        String?               @db.Text
  defaultPosition String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  lineupEntries   FixtureLineupPlayer[]

  @@index([name])
}

model FixtureLineupSnapshot {
  id              Int                   @id @default(autoincrement())
  fixtureId       Int
  teamId          Int
  formation       String?
  coachApiId      Int?
  coachName       String?
  isConfirmed     Boolean               @default(false)
  starterCount    Int                   @default(0)
  substituteCount Int                   @default(0)
  contentHash     String
  capturedAt      DateTime              @default(now())
  rawPayload      Json?
  fixture         Fixture               @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  team            Team                  @relation(fields: [teamId], references: [id])
  players         FixtureLineupPlayer[]

  @@unique([fixtureId, teamId, contentHash])
  @@index([fixtureId, teamId, capturedAt])
  @@index([teamId, capturedAt])
}

model FixtureLineupPlayer {
  id               Int                   @id @default(autoincrement())
  lineupSnapshotId Int
  playerId         Int
  isStarter        Boolean
  shirtNumber      Int?
  position         String?
  grid             String?
  lineupOrder      Int?
  lineupSnapshot   FixtureLineupSnapshot @relation(fields: [lineupSnapshotId], references: [id], onDelete: Cascade)
  player           Player                @relation(fields: [playerId], references: [id])

  @@unique([lineupSnapshotId, playerId])
  @@index([playerId, isStarter])
  @@index([lineupSnapshotId, isStarter])
}

model Bookmaker {
  id              Int              @id @default(autoincrement())
  apiBookmakerId  Int              @unique
  name            String
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  oddsSnapshots   OddsSnapshot[]
  recommendations Recommendation[]
  backtestBets    BacktestBet[]
}

model BettingMarket {
  id            Int            @id @default(autoincrement())
  apiBetId      Int?
  marketCode    String         @unique
  name          String
  marketGroup   String
  lineValue     Float?
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  oddsSnapshots OddsSnapshot[]
}

model OddsSnapshot {
  id              Int              @id @default(autoincrement())
  fixtureId       Int
  bookmakerId     Int
  marketId        Int
  selectionCode   String
  selectionName   String
  lineValue       Float?
  decimalOdds     Float
  isLive          Boolean          @default(false)
  apiUpdatedAt    DateTime?
  capturedAt      DateTime         @default(now())
  rawPayload      Json?
  fixture         Fixture          @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  bookmaker       Bookmaker        @relation(fields: [bookmakerId], references: [id])
  market          BettingMarket    @relation(fields: [marketId], references: [id])
  recommendations Recommendation[]
  backtestBets    BacktestBet[]

  @@index([fixtureId, marketId, capturedAt])
  @@index([fixtureId, bookmakerId, marketId, selectionCode, capturedAt])
}

model OddsCollectionCheckpoint {
  id             Int       @id @default(autoincrement())
  fixtureId      Int
  horizonMinutes Int
  dueAt          DateTime
  status         String    @default("PENDING") @db.VarChar(32)
  attemptedAt    DateTime?
  completedAt    DateTime?
  nextRetryAt    DateTime?
  attempts       Int       @default(0)
  processed      Int       @default(0)
  inserted       Int       @default(0)
  lockToken      String?   @db.VarChar(64)
  errorMessage   String?   @db.Text
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, horizonMinutes])
  @@index([status, dueAt])
  @@index([fixtureId, completedAt])
}

model ExternalPrediction {
  id              Int      @id @default(autoincrement())
  fixtureId       Int      @unique
  homeProbability Float?
  drawProbability Float?
  awayProbability Float?
  advice          String?  @db.Text
  predictedWinner String?
  rawPayload      Json?
  capturedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fixture         Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
}

model ExternalPredictionSnapshot {
  id              Int      @id @default(autoincrement())
  fixtureId       Int
  homeProbability Float?
  drawProbability Float?
  awayProbability Float?
  advice          String?  @db.Text
  predictedWinner String?
  rawPayload      Json?
  payloadHash     String   @db.VarChar(64)
  capturedAt      DateTime
  createdAt       DateTime @default(now())

  @@unique([fixtureId, payloadHash])
  @@index([fixtureId, capturedAt])
}

model Recommendation {
  id                    Int                  @id @default(autoincrement())
  fixtureId             Int
  bookmakerId           Int
  oddsSnapshotId        Int
  marketCode            String
  marketName            String
  marketGroup           String
  selectionCode         String
  selectionName         String
  lineValue             Float?
  decimalOdds           Float
  modelProbability      Float
  fairMarketProbability Float
  impliedProbability    Float
  edge                  Float
  expectedValue         Float
  confidenceScore       Float
  dataQualityScore      Float
  recommendationScore   Float
  rankNumber            Int?
  modelVersion          String
  reasons               Json
  status                RecommendationStatus @default(ACTIVE)
  settlementResult      SettlementResult     @default(PENDING)
  simulatedProfitUnits  Float?
  generatedAt           DateTime             @default(now())
  expiresAt             DateTime
  settledAt             DateTime?
  fixture               Fixture              @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  bookmaker             Bookmaker            @relation(fields: [bookmakerId], references: [id])
  oddsSnapshot          OddsSnapshot         @relation(fields: [oddsSnapshotId], references: [id])

  @@index([status, generatedAt])
  @@index([fixtureId, status])
  @@index([marketCode, settlementResult])
}

model SyncRun {
  id           Int        @id @default(autoincrement())
  jobName      String
  status       SyncStatus @default(RUNNING)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  processed    Int        @default(0)
  inserted     Int        @default(0)
  updated      Int        @default(0)
  errorMessage String?    @db.Text
  metadata     Json?

  @@index([jobName, startedAt])
  @@index([status])
}

model ApiUsage {
  id              Int      @id @default(autoincrement())
  endpoint        String
  requestDate     DateTime @default(now())
  responseStatus  Int
  dailyLimit      Int?
  dailyRemaining  Int?
  minuteLimit     Int?
  minuteRemaining Int?
  durationMs      Int?
  errorMessage    String?  @db.Text

  @@index([requestDate])
  @@index([endpoint, requestDate])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model BacktestRun {
  id                   Int            @id @default(autoincrement())
  name                 String
  leagueId             Int?
  dateFrom             DateTime
  dateTo               DateTime
  fixtureLimit         Int
  stakeUnits           Float          @default(1)
  modelVersion         String
  rules                Json
  status               BacktestStatus @default(RUNNING)
  startedAt            DateTime       @default(now())
  finishedAt           DateTime?
  totalFixtures        Int            @default(0)
  eligibleFixtures     Int            @default(0)
  totalBets            Int            @default(0)
  wins                 Int            @default(0)
  losses               Int            @default(0)
  pushes               Int            @default(0)
  voids                Int            @default(0)
  hitRate              Float?
  profitUnits          Float          @default(0)
  roi                  Float?
  yieldRate            Float?
  averageOdds          Float?
  averageExpectedValue Float?
  maximumDrawdown      Float?
  brierScore           Float?
  errorMessage         String?        @db.Text
  league               League?        @relation(fields: [leagueId], references: [id])
  bets                 BacktestBet[]

  @@index([startedAt])
  @@index([status])
  @@index([leagueId, dateFrom, dateTo])
}

model BacktestBet {
  id                    Int              @id @default(autoincrement())
  runId                 Int
  fixtureId             Int
  bookmakerId           Int
  oddsSnapshotId        Int
  predictedAt           DateTime
  kickoffAt             DateTime
  marketCode            String
  marketName            String
  marketGroup           String
  selectionCode         String
  selectionName         String
  lineValue             Float?
  decimalOdds           Float
  modelProbability      Float
  fairMarketProbability Float
  edge                  Float
  expectedValue         Float
  confidenceScore       Float
  dataQualityScore      Float
  recommendationScore   Float
  rankNumber            Int
  settlementResult      SettlementResult
  stakeUnits            Float
  profitUnits           Float
  homeGoals             Int
  awayGoals             Int
  reasons               Json
  createdAt             DateTime         @default(now())
  run                   BacktestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  fixture               Fixture          @relation(fields: [fixtureId], references: [id])
  bookmaker             Bookmaker        @relation(fields: [bookmakerId], references: [id])
  oddsSnapshot          OddsSnapshot     @relation(fields: [oddsSnapshotId], references: [id])

  @@index([runId, kickoffAt])
  @@index([marketCode, settlementResult])
  @@index([fixtureId])
}

model FixtureTeamMetric {
  id                  Int      @id @default(autoincrement())
  fixtureId           Int
  teamId              Int
  expectedGoals       Float?
  expectedGoalsSource String?
  shots               Int?
  shotsOnGoal         Int?
  possession          Float?
  corners             Int?
  fouls               Int?
  yellowCards         Int?
  redCards            Int?
  capturedAt          DateTime @default(now())
  rawPayload          Json?

  @@unique([fixtureId, teamId])
  @@index([teamId, fixtureId])
  @@index([capturedAt])
}

model FixtureTeamMetricSnapshot {
  id                  Int      @id @default(autoincrement())
  fixtureId           Int
  teamId              Int
  expectedGoals       Float?
  expectedGoalsSource String?
  shots               Int?
  shotsOnGoal         Int?
  possession          Float?
  corners             Int?
  fouls               Int?
  yellowCards         Int?
  redCards            Int?
  rawPayload          Json?
  payloadHash         String   @db.VarChar(64)
  capturedAt          DateTime
  createdAt           DateTime @default(now())

  @@unique([fixtureId, teamId, payloadHash])
  @@index([fixtureId, teamId, capturedAt])
  @@index([teamId, capturedAt])
}

model HistoricalDataAuditRun {
  id                           Int       @id @default(autoincrement())
  auditVersion                 String    @db.VarChar(160)
  policyVersion                String    @db.VarChar(160)
  status                       String    @db.VarChar(24)
  dateFrom                     DateTime
  dateTo                       DateTime
  replayFixtures               Int
  replayPredictions            Int
  oddsSnapshots                Int
  fixturesWithAnyOdds          Int
  fixturesWithT90Odds          Int
  rawMetricSnapshots           Int
  fundamentalSnapshots         Int
  featureSnapshots             Int
  featureRowsWithLineage       Int
  featureRowsWithMarketLineage Int
  pitViolations                Int       @default(0)
  recommendationStatus         String    @db.VarChar(64)
  summary                      Json
  recommendation               Json
  artifactDirectory            String    @db.VarChar(512)
  payloadHash                  String    @unique @db.VarChar(64)
  startedAt                    DateTime  @default(now())
  finishedAt                   DateTime?
  errorMessage                 String?   @db.Text

  @@index([status, startedAt], map: "HistoricalDataAuditRun_status_started_idx")
  @@index([recommendationStatus, startedAt], map: "HistoricalDataAuditRun_recommendation_started_idx")
}

model HistoricalDataAuditFinding {
  id          Int      @id @default(autoincrement())
  runId       Int
  category    String   @db.VarChar(48)
  severity    String   @db.VarChar(16)
  code        String   @db.VarChar(96)
